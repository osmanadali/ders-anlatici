# Hocanın beyni: ikisinden birini (ya da ikisini) doldur.
# Gemini: ÜCRETSİZ kota (günlük sınırlı). Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude: ücretli, en derin ve isabetli. Anahtar: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Boş = hangi anahtar varsa o (ikisi de varsa Claude). Zorlamak için: gemini | claude
LLM_PROVIDER=
# Gemini modeli: boş = otomatik (en uygun Flash). Ayarlar'dan listeden de seçilebilir.
GEMINI_MODEL=
# "Önce çöz, sonra anlat": auto (Gemini'de açık) | on | off
DEEP_SOLVE=auto

# Claude modeli ve düşünme derinliği (low | medium | high)
CLAUDE_MODEL=claude-opus-5-5
EFFORT=medium

# Ses ve konuşma tanıma varsayılan olarak ÜCRETSİZ:
#   TTS_PROVIDER: edge (hazır Türkçe ses) | xtts (kendi sesinin ücretsiz klonu) | browser
#   STT_PROVIDER: whisper (bilgisayarında çalışır)
TTS_PROVIDER=edge
STT_PROVIDER=whisper
# Whisper modeli: large-v3-turbo (isabetli, ~1.6 GB) | small (hızlı, zayıf bilgisayarlar için)
WHISPER_MODEL=large-v3-turbo

# Verilerin (notlar, kayıtlar) tutulacağı klasör
DATA_DIR=veri

# --- İsteğe bağlı, ÜCRETLİ: ElevenLabs (kullanmayacaksan boş bırak) ---
# ELEVENLABS_API_KEY=
# VOICE_ID=zu3iuxxlZoTwzmAUvpNF
# TTS_MODEL=eleven_multilingual_v2

# Telefondan erişim şifresi (boşsa baslat.py --telefon kendisi üretir)
# ERISIM_SIFRESI=
